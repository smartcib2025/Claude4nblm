# --- Telegram ---
# Token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# --- Anthropic / Claude ---
# API key for unattended (headless / VPS) use. Required unless you have logged
# the bundled Claude Code CLI into a Claude subscription on this machine.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Authorization ---
# Optional: comma-separated Telegram chat IDs to pre-authorize (skip pairing).
# Leave empty to authorize everyone via the pairing-code flow.
ALLOWED_CHAT_IDS=

# Where the persisted allowlist JSON lives.
ALLOWLIST_PATH=./state/allowlist.json

# --- Claude runtime ---
# Working directory Claude runs in (for file reads/writes, repos, etc.).
WORKDIR=.

# Optional: override the assistant system prompt.
# CLAUDE_SYSTEM_PROMPT=

# --- NotebookLM ---
# Optional default notebook name/id the assistant should research against.
NOTEBOOKLM_NOTEBOOK=

# Optional: override how the NotebookLM MCP server is launched.
# NOTEBOOKLM_MCP_COMMAND=npx
# NOTEBOOKLM_MCP_ARGS=notebooklm-mcp@latest
