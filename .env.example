# --- Telegram ---
# Token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# --- Anthropic / Claude ---
# API key for unattended (headless / VPS) use. Required unless you have logged
# the bundled Claude Code CLI into a Claude subscription on this machine.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Authorization ---
# Optional: comma-separated Telegram chat IDs to pre-authorize (skip pairing).
# Leave empty to authorize everyone via the pairing-code flow.
ALLOWED_CHAT_IDS=

# Where the persisted allowlist JSON lives.
ALLOWLIST_PATH=./state/allowlist.json

# --- Claude runtime ---
# Working directory Claude runs in (for file reads/writes, repos, etc.).
WORKDIR=.

# Optional: override the assistant system prompt.
# CLAUDE_SYSTEM_PROMPT=

# --- NotebookLM (via the notebooklm-py CLI, used as a RAG backend) ---
# Optional default notebook id the assistant should research against.
NOTEBOOKLM_NOTEBOOK=

# Headless / VPS auth fast path: paste the FULL contents of the
# storage_state.json produced by `notebooklm login` on a desktop. When set, the
# CLI uses it directly with no browser. (Alternatively copy storage_state.json
# to ~/.notebooklm/profiles/default/ on the server.)
# NOTEBOOKLM_AUTH_JSON=

# Optional: a command the CLI runs to refresh cookies when they expire
# (self-healing on a long-running server). See docs/vps-deployment.md.
# NOTEBOOKLM_REFRESH_CMD=
